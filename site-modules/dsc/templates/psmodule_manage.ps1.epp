<%- |
  String[1] $module_name,
  String[1] $version,
  Enum['present', 'absent'] $ensure,
  Optional[String[1]] $repository = undef,
  Optional[Stdlib::Absolutepath] $source = undef
| -%>
<#
.SYNOPSIS
  Manage PowerShell module installation or removal

.DESCRIPTION
  This script installs or uninstalls a PowerShell module with the specified version.
  It handles:
  - Installation from PowerShell Gallery or custom repositories
  - Installation from local .nupkg files
  - Module removal
  - Cache invalidation after changes

.PARAMETER ModuleName
  Name of the PowerShell module

.PARAMETER Version
  Exact version to install/remove (semantic version format X.Y.Z)

.PARAMETER Ensure
  Desired state: 'present' or 'absent'

.PARAMETER Repository
  PowerShell repository name (defaults to PSGallery if not specified)

.PARAMETER Source
  Local .nupkg file path for offline installation
#>

[CmdletBinding()]
param()

$ErrorActionPreference = 'Stop'

$ModuleName = '<%= $module_name %>'
$Version = '<%= $version %>'
$Ensure = '<%= $ensure %>'
<% if $repository { -%>
$Repository = '<%= $repository %>'
<% } else { -%>
$Repository = 'PSGallery'
<% } -%>
<% if $source { -%>
$Source = '<%= $source %>'
<% } else { -%>
$Source = $null
<% } -%>

# Helper function to invalidate the dsc_modules fact cache
function Clear-DscModulesCache {
    $cacheDir = if ($IsWindows -or $PSVersionTable.PSVersion.Major -lt 6) {
        "$env:ProgramData\PuppetLabs\facter\facts.d"
    } else {
        "/opt/puppetlabs/facter/facts.d"
    }

    $cacheFile = Join-Path $cacheDir "dsc_modules_cache.json"
    
    if (Test-Path $cacheFile) {
        try {
            Remove-Item -Path $cacheFile -Force -ErrorAction SilentlyContinue
            Write-Output "Cache invalidated: $cacheFile"
        } catch {
            Write-Warning "Failed to invalidate cache: $_"
        }
    }
}

try {
    if ($Ensure -eq 'present') {
        # Install the module
        Write-Output "Installing module $ModuleName version $Version..."

        # Check if a different version is already installed
        $existingModule = Get-InstalledModule -Name $ModuleName -ErrorAction SilentlyContinue
        if ($existingModule -and $existingModule.Version -ne $Version) {
            Write-Output "Removing existing version $($existingModule.Version)..."
            Uninstall-Module -Name $ModuleName -RequiredVersion $existingModule.Version -Force -ErrorAction Stop
        }

        if ($null -ne $Source) {
            # Install from local .nupkg file
            Write-Output "Installing from local file: $Source"
            
            # PowerShell doesn't have a direct Install-Module from .nupkg command
            # We need to extract and copy to modules path
            $modulesPath = if ($IsWindows -or $PSVersionTable.PSVersion.Major -lt 6) {
                "$env:ProgramFiles\PowerShell\Modules"
            } else {
                "/usr/local/share/powershell/Modules"
            }

            # For now, use Install-Module with a temporary repository
            # This is a simplified approach - production may need more sophisticated handling
            Write-Error "Local .nupkg installation requires custom repository setup. Please register the package directory as a PSRepository first."
            exit 1
        } else {
            # Install from repository
            $installParams = @{
                Name            = $ModuleName
                RequiredVersion = $Version
                Repository      = $Repository
                Scope           = 'AllUsers'
                Force           = $true
                ErrorAction     = 'Stop'
            }

            Install-Module @installParams
            Write-Output "Successfully installed module $ModuleName version $Version"
        }

        # Invalidate cache after installation
        Clear-DscModulesCache

    } elseif ($Ensure -eq 'absent') {
        # Remove the module
        Write-Output "Removing module $ModuleName version $Version..."

        $installedModule = Get-InstalledModule -Name $ModuleName -RequiredVersion $Version -ErrorAction SilentlyContinue
        if ($null -ne $installedModule) {
            Uninstall-Module -Name $ModuleName -RequiredVersion $Version -Force -ErrorAction Stop
            Write-Output "Successfully removed module $ModuleName version $Version"
            
            # Invalidate cache after removal
            Clear-DscModulesCache
        } else {
            Write-Output "Module $ModuleName version $Version is not installed (already absent)"
        }
    }

    exit 0
} catch {
    Write-Error "Failed to manage module ${ModuleName}: $_"
    exit 1
}
